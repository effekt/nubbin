{
  "name": "@nubbin/studio-ui",
  "version": "0.6.0",
  "description": "The optional React and Puck interface for a self-hosted Nubbin Studio.",
  "keywords": [
    "nubbin",
    "page-builder",
    "cms",
    "visual-editor",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/effekt/nubbin.git",
    "directory": "packages/studio-ui"
  },
  "homepage": "https://effekt.github.io/nubbin/",
  "bugs": "https://github.com/effekt/nubbin/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/defineStudioConfig.d.ts",
      "import": "./dist/defineStudioConfig.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@measured/puck": "catalog:",
    "@nubbin/core": "workspace:*",
    "@nubbin/react": "workspace:*",
    "@nubbin/studio": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
