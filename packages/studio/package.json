{
  "name": "@nubbin/studio",
  "version": "0.2.0",
  "description": "The public configuration contract for a self-hosted Nubbin Studio.",
  "keywords": [
    "nubbin",
    "page-builder",
    "cms",
    "visual-editor",
    "studio"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/effekt/nubbin.git",
    "directory": "packages/studio"
  },
  "homepage": "https://effekt.github.io/nubbin/",
  "bugs": "https://github.com/effekt/nubbin/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/useEditorStatus.d.ts",
      "import": "./dist/useEditorStatus.js"
    },
    "./consumer-origin": {
      "types": "./dist/ConsumerOriginContext.d.ts",
      "import": "./dist/ConsumerOriginContext.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nubbin/core": "workspace:*",
    "@nubbin/react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
