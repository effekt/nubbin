{
  "threshold": 1,
  "minLines": 1,
  "minTokens": 15,
  "maxLines": 200,
  "mode": "mild",
  "gitignore": true,
  "ignoreCase": true,
  "format": ["typescript", "tsx", "javascript"],
  "reporters": ["consoleFull"],
  "ignorePattern": [
    "(?m)^\\s*import\\s.*$",
    "import\\s*\\{[\\s\\S]*?\\}\\s*from\\s*.[^'\"]*.;",
    "(?m)^\\s*.use client.;?\\s*$"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "**/src/testing/**",
    "**/fixtures/**",
    "**/*.config.*",
    "**/*.schema.ts",
    "**/*.constants.ts",
    "**/PaletteIcon.tsx",
    "**/BoundedTextField.tsx",
    "**/EnumSubField.tsx",
    "**/LinkTextField.tsx",
    "**/NumberInputField.tsx",
    "**/PlainTextField.tsx",
    "**/ScalarFieldControl.tsx",
    "**/SegmentedEnumField.tsx",
    "**/FieldsetGroup.tsx",
    "**/RepeaterField.tsx",
    "**/RepeaterHead.tsx",
    "**/RepeaterRow.tsx",
    "**/RepeaterRowActions.tsx",
    "**/RepeaterRowBody.tsx",
    "**/RichTextAddBlock.tsx",
    "**/RichTextBlockList.tsx",
    "**/RichTextBlockRow.tsx",
    "**/RichTextField.tsx",
    "**/RichTextSpanList.tsx",
    "**/RichTextSpanRow.tsx",
    "**/RichTextToolbar.tsx",
    "**/SubFieldControl.tsx",
    "**/to*PuckField.tsx",
    "**/*Defaults.ts",
    "**/examples/**"
  ]
}
