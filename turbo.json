{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["tsconfig.base.json", "biome.jsonc"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "demo#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".nubbin/**"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "docs-site#build": {
      "dependsOn": [
        "@nubbin/cli#build",
        "@nubbin/core#build",
        "@nubbin/next#build",
        "@nubbin/react#build",
        "@nubbin/store-fs#build",
        "@nubbin/studio#build"
      ],
      "env": ["NUBBIN_DOCS_BASE_URL", "NUBBIN_DOCS_URL"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/**"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "fixtures:publish": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "live:record": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
