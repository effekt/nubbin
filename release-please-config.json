{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "separate-pull-requests": false,
  "group-pull-request-title-pattern": "chore(repo): release ${branch}",
  "last-release-sha": "8de65eff7d12ab4ee4a1e2179654aaf04d734245",
  "packages": {
    "packages/cli": {
      "component": "cli"
    },
    "packages/core": {
      "component": "core",
      "extra-files": ["src/version.constants.ts"]
    },
    "packages/next": {
      "component": "next"
    },
    "packages/react": {
      "component": "react"
    },
    "packages/store-fs": {
      "component": "store-fs"
    },
    "packages/studio": {
      "component": "studio"
    },
    "packages/studio-ui": {
      "component": "studio-ui"
    }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "nubbin",
      "components": ["cli", "core", "next", "react", "store-fs", "studio", "studio-ui"],
      "merge": false
    }
  ]
}
